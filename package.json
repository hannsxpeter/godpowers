{
  "name": "godpowers",
  "version": "7.0.1",
  "description": "Durable project state, evidence-backed \"done\", and gates enforced by hooks for Claude Code, Codex, and other AI coding tools. Eight commands, four agents, about 4K tokens of instructions.",
  "bin": {
    "godpowers": "./bin/godpowers.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "agents/"
  ],
  "scripts": {
    "test": "node scripts/run-tests.js",
    "coverage": "c8 --all --include=lib/**/*.js --check-coverage --lines 90 --branches 75 --reporter=text --reporter=text-summary node scripts/run-tests.js",
    "budget": "node bin/godpowers.js budget",
    "lint": "node scripts/check-text.js",
    "pack:check": "node scripts/check-pack.js",
    "ab": "node scripts/ab-eval.js",
    "release:check": "npm run lint && npm run coverage && npm run budget && npm run pack:check && npm audit --omit=dev"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "claude-code",
    "codex",
    "agent-skills",
    "hooks",
    "verification",
    "developer-tools"
  ],
  "author": "Godpowers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannsxpeter/godpowers.git"
  },
  "homepage": "https://github.com/hannsxpeter/godpowers#readme",
  "bugs": {
    "url": "https://github.com/hannsxpeter/godpowers/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
