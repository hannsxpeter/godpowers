{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godpowers.dev/schema/events.v1.json",
  "title": "Godpowers Event (v1)",
  "description": "OpenTelemetry-shape event. One per line in events.jsonl. Append-only.",
  "$defs": {
    "decisionAttrs": {
      "type": "object",
      "required": ["decision", "reason", "evidence", "result"],
      "properties": {
        "decision": { "type": "string", "minLength": 8, "maxLength": 240 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:@%/\\-]*)?(#[A-Za-z0-9._:\\-]+)?|(event|command|artifact|git):[A-Za-z0-9_./:@#=+\\-]+|(\\.?\\.?/)?([A-Za-z0-9_.@\\-]+/)*[A-Za-z0-9_.@\\-]+\\.[A-Za-z0-9]+(:[A-Za-z0-9_.\\-]+)?(#[A-Za-z0-9_.:\\-]+)?)$"
          }
        },
        "result": { "type": "string", "minLength": 1, "maxLength": 240 },
        "tier": { "type": "string", "minLength": 1, "maxLength": 64 },
        "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifact": { "type": "string", "minLength": 1, "maxLength": 240 },
        "requirement": { "type": "string", "minLength": 1, "maxLength": 64 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "minLength": 1, "maxLength": 64 },
        "note": { "type": "string", "minLength": 1, "maxLength": 240 },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "approved": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "name": { "const": "decision.recorded" } },
        "required": ["name"]
      },
      "then": {
        "properties": { "attrs": { "$ref": "#/$defs/decisionAttrs" } },
        "required": ["attrs"]
      }
    }
  ],
  "type": "object",
  "required": ["trace_id", "span_id", "ts", "name"],
  "properties": {
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16,32}$",
      "description": "Identifies the run."
    },
    "span_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,16}$",
      "description": "Identifies the span (operation) within the trace."
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,16}$",
      "description": "Parent span_id. Omitted for root spans."
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "enum": [
        "workflow.run",
        "workflow.complete",
        "agent.start",
        "agent.end",
        "agent.pause",
        "agent.yolo-resolve",
        "user.resolve",
        "tool.call",
        "tool.result",
        "model.call",
        "decision.route",
        "decision.recorded",
        "artifact.created",
        "artifact.updated",
        "artifact.hash",
        "have-nots.check",
        "gate.fail",
        "gate.pass",
        "change.proposed",
        "change.accepted",
        "change.rejected",
        "tier.skip",
        "state.repair",
        "state.rollback",
        "local-helper.run",
        "local-helper.complete",
        "dashboard.render",
        "host-capabilities.detect",
        "dogfood.run",
        "source-system.import",
        "source-system.sync-back",
        "repo-doc-sync.detect",
        "repo-surface-sync.detect",
        "extension.install",
        "extension.activate",
        "cost.recorded",
        "cache.hit",
        "cache.miss",
        "budget.exceeded",
        "context.loadout",
        "lesson.recorded",
        "lesson.recalled",
        "proposal.proposed",
        "proposal.accepted",
        "proposal.rejected",
        "error",
        "warn"
      ]
    },
    "attrs": {
      "type": "object",
      "description": "Event-specific attributes. Schema varies by event name."
    }
  },
  "additionalProperties": false
}
