{
  "description": "Godpowers gates: session brief, verification before finishing, and lint before commits",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/godpowers.js\" hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/godpowers.js\" hook stop",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/godpowers.js\" hook pre-tool-use",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
